<feature-group-spec name="security-manager" xmlns="urn:jboss:galleon:feature-group:1.0">
    <!--
        In EE 11+ feature packs, this feature-group-spec becomes a no-op because EE 11+ servers don't support the use
        of the SecurityManager. The security manager subsystem has been converted into a model-only subsystem that is
        only usable in Domain Mode.

        We could have removed the Galleon layer and this feature-group-spec, but we decided to keep the Galleon layer
        to allow a smooth transition for existing configurations that include the security-manager Galleon layer.
    -->
</feature-group-spec>
