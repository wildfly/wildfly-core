<!--
    Configuration to test transforming the model from 20.0 (WildFly 42) to 19.0 (WildFly 41 / EAP 8)
    TODO Keep the from version up to date with later releases. -->

<subsystem xmlns="urn:wildfly:elytron:community:19.0">
    <security-realms>
        <token-realm name="JwtRealmWithAllowedJkuValues" principal-claim="sub">
            <jwt issuer="elytron-oauth2-realm" audience="my-app-valid" allowed-jku-values="https://localhost:50831"/>
        </token-realm>
    </security-realms>
</subsystem>
