<!--
    Configuration to test transforming the model from 20.0 (WildFly 42) to 19.0 (WildFly 41 / EAP 8)
    TODO Keep the from version up to date with later releases. -->

<subsystem xmlns="urn:wildfly:elytron:community:19.0">
    <security-realms>
        <token-realm name="TokenRealmWithTransformer" principal-claim="sub" principal-transformer="myCasePrincipalTransformerUpper">
            <jwt issuer="elytron-oauth2-realm" audience="my-app-valid"/>
        </token-realm>
    </security-realms>

    <mappers>
        <case-principal-transformer name="myCasePrincipalTransformerUpper" upper-case="true"/>
    </mappers>
</subsystem>
